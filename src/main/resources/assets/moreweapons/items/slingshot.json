{
  "model": {
    "type": "minecraft:condition",
    "property": "minecraft:using_item",
    "on_false": { "type": "minecraft:model", "model": "moreweapons:item/slingshot" },
    "on_true":  {
      "type": "minecraft:range_dispatch",
      "property": "minecraft:use_duration",
      "scale": 0.05,
      "entries": [
        { "threshold": 0.1, "model": { "type": "minecraft:model", "model": "moreweapons:item/slingshot_pulling_1" } },
        { "threshold": 0.25, "model": { "type": "minecraft:model", "model": "moreweapons:item/slingshot_pulling_2" } }
      ],
      "fallback": { "type": "minecraft:model", "model": "moreweapons:item/slingshot_pulling_0" }
    }
  }
}